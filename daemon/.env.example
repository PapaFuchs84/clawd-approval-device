# Copy to .env, fill in real values, NEVER commit .env.
# Generate tokens with: python3 -c "import secrets; print(secrets.token_hex(32))"

CLAWD_APPROVAL_TOKEN=<INSERT_RANDOM_64_HEX_TOKEN_HERE>
CLAWD_APPROVAL_HMAC_KEY=<INSERT_A_SECOND_RANDOM_64_HEX_TOKEN_HERE>
CLAWD_APPROVAL_BIND=0.0.0.0
CLAWD_APPROVAL_PORT=8765
# Optional: seconds to wait for a button press before falling back to
# Claude Code's normal confirmation dialog (see docs/PROTOCOL.md). Default 25.
# CLAWD_APPROVAL_TIMEOUT=25
